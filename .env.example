LEASELENS_DB_PATH=./data/leaselens.db
# Deployment profiles (Sprint B.9 / #9):
#  - Local dev:      both flags false (no guardrails; not exposed).
#  - Portfolio demo: LEASELENS_DEMO_MODE=true (demo UI + role switcher +
#                    budget guardrails; seeded demo identities).
#  - Public anon:    LEASELENS_PUBLIC_ANON_MODE=true (per-visitor isolation +
#                    quota + retention + guardrails). Fails closed at boot
#                    unless ANTHROPIC_API_KEY + a positive spend ceiling are set.
# DEMO_MODE controls demo UI affordances ONLY; guardrails enforce in EITHER
# exposed mode (demo OR public-anon).
LEASELENS_DEMO_MODE=false
LEASELENS_PUBLIC_ANON_MODE=false
LEASELENS_ANTHROPIC_MODEL=claude-haiku-4-5
LEASELENS_DAILY_SPEND_CEILING_USD=2
ANTHROPIC_API_KEY=sk-ant-dummy-placeholder
LEASELENS_SESSION_SECRET=at-least-32-characters-long-secret-placeholder
LEASELENS_LEASE_MAX_BYTES=1048576
LEASELENS_LEASE_MAX_PAGES=30
LEASELENS_AUTO_SCAN_ENABLED=true
LEASELENS_LOG_LEVEL=info
# Sprint A.8 (#8) — request guards (timeouts/bulkheads + size budgets).
LEASELENS_MESSAGE_MAX_CHARS=8000
LEASELENS_BODY_MAX_BYTES=1048576
LEASELENS_ANTHROPIC_TIMEOUT_MS=60000
LEASELENS_TOOL_TIMEOUT_MS=30000
